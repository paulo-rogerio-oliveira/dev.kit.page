# Raiz da API do dev.kit.page (sem barra no fim). Copie para .env.local e ajuste.
VITE_API_URL=http://localhost:5080
# A URL pública do site (sem barra no fim), para o canonical e o Open Graph; vazia, ficam relativos.
VITE_SITE_URL=

# Preview isolado: npm run build:preview exige ambas as URLs HTTPS públicas de teste.
# O gerador fornece VITE_SITE_URL consultando o ambiente Azure e VITE_API_URL por --preview-api-url.
# Não coloque tokens, senhas ou chaves em variáveis VITE_*.
