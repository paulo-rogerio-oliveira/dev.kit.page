# Normaliza finais de linha no repositório (LF), deixando o checkout nativo.
* text=auto

*.ps1 text eol=crlf
*.slnx text eol=crlf
# O WebJob do worker (api/src/DevKitPage.Provisao/webjob): o run.sh roda no Linux, o run.cmd no Windows.
*.sh text eol=lf
*.cmd text eol=crlf

*.png binary
*.ico binary
# As mídias da landing (web/public/midia): o text=auto não pode tocar nelas.
*.mp4 binary
*.webm binary
*.gif binary
*.jpg binary
*.webp binary
