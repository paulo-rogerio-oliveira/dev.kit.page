<Project Sdk="Microsoft.NET.Sdk">

  <!--
    O acesso a dados (EF Core) e a implementação dos serviços do Core. O framework do ASP.NET Core
    entra pelo PasswordHasher do Identity e pelas extensões de configuração/options — o mesmo que a
    API já carrega, sem pacote a mais.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DevKitPage.Core\DevKitPage.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <!-- Só para subir a versão do que o SqlClient traz (ver Directory.Packages.props): não é usado direto. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <!-- As imagens do design (US #669) no Azure Blob Storage. -->
    <PackageReference Include="Azure.Storage.Blobs" />
  </ItemGroup>

  <!--
    Os scripts do Azure SQL embutidos SÓ para a verificação do esquema na subida (EsquemaDoBanco): ela diz qual script
    traz a tabela ou a coluna que falta. Nenhum deles é executado pela API.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\scripts\sqlserver\*.sql" LogicalName="sqlserver/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
