{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DevKitPage": "Data Source=dados/devkitpage.db"
  },
  "Banco": {
    "Provider": "Sqlite"
  },
  "Jwt": {
    "Emissor": "dev.kit.page",
    "Audiencia": "dev.kit.page",
    "ExpiracaoMinutos": 60,
    "MaxFalhas": 5,
    "BloqueioMinutos": 15
  },
  "Telemetria": {
    "RetencaoDias": 180,
    "MaxEventosPorLote": 1000,
    "MaxBytesPorLote": 1048576
  },
  "Demonstracoes": {
    "RetencaoDias": 365,
    "LimitePorMinuto": 5
  },
  "Remoto": {
    "IntervaloDoHeartbeatSegundos": 60,
    "ToleranciaDoHeartbeatSegundos": 180,
    "EnviosPorMinuto": 60,
    "MaximoDeMaquinas": 10,
    "MaxBytesPorEnvio": 262144,
    "RetencaoDias": 30
  },
  "Provisao": {
    "Ambiente": "dev",
    "PrefixoDoGrupo": "rg-devkit",
    "Regioes": [ "brazilsouth", "eastus2" ],
    "RegiaoPadrao": "brazilsouth",
    "NomeDaFila": "comandos",
    "PlanosQueLiberam": [],
    "PedidosPorMinuto": 10
  },
  "Proxy": {
    "RedesConfiaveis": []
  },
  "Seed": {
    "AdminLogin": "admin"
  },
  "Cors": {
    "Origens": []
  }
}
